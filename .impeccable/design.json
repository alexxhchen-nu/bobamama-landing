  "narrative": {
    "northStar": "Grandma's Pearl Stall",
    "overview": "Bobamama looks like a cozy pearl milk tea shop you can walk into—warm wood, milk foam, leaf greens, and a little idle-game playfulness. Illustration and scene carry the brand; UI is chunky, rounded, and tactile so buttons feel like counter props, not SaaS chrome.\n\nThe system rejects coupon-board redeem metaphors, purple-gradient AI defaults, and dense dashboard layouts. Marketing surfaces lead with the Bobamama name at hero scale, one headline, one short support line, and a full-bleed shop image.",
    "keyCharacteristics": [
      "Full-bleed illustrated shop as the primary visual plane",
      "Warm wood + milk tea neutrals with meadow leaf accents",
      "Chunky bordered pills with hard offset shadows (tactile game UI)",
      "Display face Fuzzy Bubbles; body Balsamiq Sans",
      "Progress teased via cast unlocks / pearls—economy systems stay soft"
    ],
    "rules": [
      {
        "name": "The Rarity Accent Rule",
        "body": "Lemon CTA and blush stay sparse. Most of the screen is milk, wood, and leaf—action yellow earns attention by rarity.",
        "section": "colors"
      },
      {
        "name": "The No-Eyebrow Rule",
        "body": "Do not add kicker labels above headings; the heading carries its own weight.",
        "section": "typography"
      },
      {
        "name": "The Pressable Rule",
        "body": "Interactive primary controls use offset shadows that compress on :active. Decorative cards should not fake the same press unless they are interactive.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do lead marketing heroes with Bobamama at brand-mark scale plus one headline and one CTA group over full-bleed shop art.",
      "Do keep lemon CTA rare and high-contrast against bark/milk.",
      "Do use open/locked cast states to tease progression without inventing economy UI.",
      "Do honor prefers-reduced-motion (disable ken-burns, pop, draw animations)."
    ],
    "donts": [
      "Don't center a coupon/redeem wooden-board form as the product metaphor.",
      "Don't introduce purple-on-white AI gradients, glassmorphism stacks, or dashboard card grids as the page structure.",
      "Don't put pricing, MOE/dictionary headlines, or search-volume claims on the landing.",
      "Don't treat temporary concept art as final brand assets—swap when real illustrations land."
    ]
  }
